const COROS_CLIENT_ID = process.env.COROS_CLIENT_ID!;
const COROS_CLIENT_SECRET = process.env.COROS_CLIENT_SECRET!;
const REDIRECT_URI = `${process.env.NEXT_PUBLIC_SITE_URL}/api/auth/coros/callback`;

/**
 * Returns the authorization URL to redirect users to COROS sign-in
 */
export function getCorosAuthUrl(athleteId: string): string {
  const state = Buffer.from(JSON.stringify({ athleteId })).toString('base64');
  return `https://open.coros.com/oauth/authorize?client_id=${COROS_CLIENT_ID}&response_type=code&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&state=${state}`;
}

/**
 * Exchanges authorization code for access and refresh tokens
 */
export async function exchangeCorosCode(code: string) {
  const response = await fetch('https://open.coros.com/oauth/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({
      client_id: COROS_CLIENT_ID,
      client_secret: COROS_CLIENT_SECRET,
      grant_type: 'authorization_code',
      code,
      redirect_uri: REDIRECT_URI,
    }),
  });

  if (!response.ok) {
    throw new Error(`COROS token exchange failed: ${response.statusText}`);
  }

  return response.json() as Promise<{
    access_token: string;
    refresh_token: string;
    expires_in: number;
    openId: string;
  }>;
}
</file>

<file path="lib/coros/scanner.ts">
import { supabase } from '@/lib/supabase';
import { extractSubTrack, RouteConfig } from '@/lib/geo/matcher';
import { verifyAttempt } from '@/lib/verifier';
import * as turf from '@turf/turf';

export async function scanAndSyncCorosActivities(athleteId: string, accessToken: string) {
  // 1. Fetch user workouts from COROS Open API
  const response = await fetch('https://open.coros.com/v2/coros/workout/list?mode=1', {
    headers: {
      Authorization: `Bearer ${accessToken}`,
      'Content-Type': 'application/json',
    },
  });

  if (!response.ok) throw new Error('Failed to fetch COROS workout list');
  const data = await response.json();
  const workouts = data.data?.resultList || [];

  // 2. Fetch all site routes and baseline GeoJSON lines
  const { data: routes } = await supabase.from('routes').select('*');
  if (!routes) return;

  for (const workout of workouts) {
    // Fetch detailed activity streams (lat/lng, altitude, timestamps)
    const streamRes = await fetch(`https://open.coros.com/v2/coros/workout/detail?labelId=${workout.labelId}`, {
      headers: { Authorization: `Bearer ${accessToken}` },
    });
    
    if (!streamRes.ok) continue;
    const streamData = await streamRes.json();
    const points = streamData.data?.points || [];

    if (points.length === 0) continue;

    const streams = {
      latlng: points.map((p: any) => [p.latitude, p.longitude] as [number, number]),
      time: points.map((p: any) => p.timestamp),
      altitude: points.map((p: any) => p.altitude),
    };

    // 3. Test activity stream against every defined Flatiron route
    for (const route of routes) {
      if (!route.rules_geojson?.features?.[0]) continue;

      const lineStringFeature = route.rules_geojson.features[0];
      const routeConfig: RouteConfig = {
        id: route.id,
        targetDistanceKm: (route.distance_miles || 0) * 1.60934,
        maxElevationGainMeters: 5000,
        startCoordinates: lineStringFeature.geometry.coordinates[0].slice().reverse(),
        endCoordinates: lineStringFeature.geometry.coordinates.slice(-1)[0].slice().reverse(),
        bufferToleranceMeters: 30,
      };

      // Extract sub-track and verify path integrity (>= 95% inside buffer)
      const candidate = extractSubTrack(streams, routeConfig, lineStringFeature);
      const verification = verifyAttempt(candidate, routeConfig);

      if (verification.verified && verification.candidate) {
        const cand = verification.candidate;
        const formattedTime = new Date(cand.elapsedTimeSeconds * 1000).toISOString().substring(11, 19);
        const activityDate = new Date(workout.startTime * 1000).toISOString().split('T')[0];

        // 4. Save verified effort to Supabase
        await supabase.from('efforts').upsert({
          route_id: route.id,
          athlete_id: athleteId,
          time_seconds: cand.elapsedTimeSeconds,
          formatted_time: formattedTime,
          activity_date: activityDate,
          verified: true,
          category_tags: ['Male', 'Unsupported'],
          source: 'COROS',
        });
      }
    }
  }
}
</file>

<file path="lib/geo/matcher.ts">
import * as turf from '@turf/turf';
import { ActivityStreams } from '../strava/scraper';

export interface SubTrackCandidate {
  startIndex: number;
  endIndex: number;
  slicedCoordinates: [number, number][]; // [lat, lng]
  slicedTime: number[];
  slicedAltitude: number[];
  elapsedTimeSeconds: number;
  elevationGainMeters: number;
  distanceKm: number;
  bufferMatchRatio: number;
}

export interface RouteConfig {
  id: string;
  targetDistanceKm: number;
  maxElevationGainMeters: number;
  startCoordinates: [number, number]; // [lat, lng]
  endCoordinates: [number, number];   // [lat, lng]
  bufferToleranceMeters: number;
}

/**
 * Scans activity streams for route start/end points and extracts matching sub-tracks.
 */
export function extractSubTrack(
  streams: ActivityStreams,
  routeConfig: RouteConfig,
  officialLineStringGeoJSON: turf.Feature<turf.LineString>
): SubTrackCandidate | null {
  const { latlng, time, altitude } = streams;
  const bufferTolerance = routeConfig.bufferToleranceMeters || 30;

  const startPoint = turf.point([routeConfig.startCoordinates[1], routeConfig.startCoordinates[0]]);
  const endPoint = turf.point([routeConfig.endCoordinates[1], routeConfig.endCoordinates[0]]);

  // 1. Identify Candidate Start & End Point Indices
  const startIndices: number[] = [];
  const endIndices: number[] = [];

  for (let i = 0; i < latlng.length; i++) {
    const pt = turf.point([latlng[i][1], latlng[i][0]]);
    const distToStart = turf.distance(pt, startPoint, { units: 'meters' });
    if (distToStart <= bufferTolerance) {
      startIndices.push(i);
    }
  }

  for (let j = 0; j < latlng.length; j++) {
    const pt = turf.point([latlng[j][1], latlng[j][0]]);
    const distToEnd = turf.distance(pt, endPoint, { units: 'meters' });
    if (distToEnd <= bufferTolerance) {
      endIndices.push(j);
    }
  }

  if (startIndices.length === 0 || endIndices.length === 0) {
    return null; // Route start or end point not reached in activity
  }

  // 2. Build 30-meter Buffer Polygon around the baseline route
  const routeBufferPolygon = turf.buffer(officialLineStringGeoJSON, 0.03, { units: 'kilometers' });[cite: 1]

  let bestCandidate: SubTrackCandidate | null = null;

  // 3. Evaluate Candidate Start/End Index Pairs (i, j)
  const pointBufferStatus = latlng.map(([lat, lng]) => {
    const p = turf.point([lng, lat]);
    return turf.booleanPointInPolygon(p, routeBufferPolygon);
  });
  for (const i of startIndices) {
    for (const j of endIndices) {
      if (j <= i + 5) continue; // Ensure a minimal valid sub-track duration

      const slicedLatlng = latlng.slice(i, j + 1);
      const slicedTime = time.slice(i, j + 1);
      const slicedAltitude = altitude.slice(i, j + 1);

      // Verify Buffer Coverage (>= 95% of points must lie inside route buffer)
      let insideCount = 0;
      for (let k = i; k <= j; k++) {
        if (pointBufferStatus[k]) insideCount++;
      }

      const bufferMatchRatio = insideCount / slicedLatlng.length;

      // 4. Compute Sub-Track Metrics
      const elapsedTimeSeconds = slicedTime[slicedTime.length - 1] - slicedTime[0];[cite: 1]

      let elevationGainMeters = 0;
      let lastAltitude = slicedAltitude[0];

      for (let k = 1; k < slicedAltitude.length; k++) {
        const diff = slicedAltitude[k] - lastAltitude;
        // Only register gain if the threshold is exceeded to filter GPS noise
        if (diff > 3) { 
          elevationGainMeters += diff;
          lastAltitude = slicedAltitude[k];
        } else if (diff < -3) {
          // Update baseline for descents to accurately track subsequent climbs
          lastAltitude = slicedAltitude[k];
        }
      }

      // GeoJSON LineString coordinates use [lng, lat]
      const geoJsonCoords = slicedLatlng.map(([lat, lng]) => [lng, lat]);
      const slicedLine = turf.lineString(geoJsonCoords);
      const distanceKm = turf.length(slicedLine, { units: 'kilometers' });

      const candidate: SubTrackCandidate = {
        startIndex: i,
        endIndex: j,
        slicedCoordinates: slicedLatlng,
        slicedTime,
        slicedAltitude,
        elapsedTimeSeconds,
        elevationGainMeters: Math.round(elevationGainMeters),
        distanceKm: parseFloat(distanceKm.toFixed(2)),
        bufferMatchRatio,
      };

      // Select candidate with the best buffer match ratio and fastest elapsed time
      if (!bestCandidate || (candidate.bufferMatchRatio >= 0.95 && candidate.elapsedTimeSeconds < bestCandidate.elapsedTimeSeconds)) {
        bestCandidate = candidate;
      }
    }
  }

  return bestCandidate;
}
</file>

<file path="lib/strava/scraper.ts">
import fetch from 'node-fetch';

export interface StravaSegmentEffort {
  activity_id: string;
  athlete_name: string;
  elapsed_time_seconds: number;
}

export interface ActivityStreams {
  latlng: [number, number][]; // [lat, lng]
  time: number[];             // Seconds offset
  altitude: number[];         // Elevation in meters
}

/**
 * Retrieves top efforts from public Strava segment leaderboards.
 */
export async function fetchSegmentTopEfforts(
  segmentId: string,
  limit: number = 10
): Promise<StravaSegmentEffort[]> {
  const url = `https://www.strava.com/api/v3/segments/${segmentId}/leaderboard?page=1&per_page=${limit}`;

  const response = await fetch(url, {
    headers: {
      'User-Agent': 'FastestFlattiesScraper/1.0',
      'Accept': 'application/json',
    },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch segment leaderboard ${segmentId}: ${response.statusText}`);
  }

  const data = (await response.json()) as any;
  const entries = data.entries || [];

  return entries.map((entry: any) => ({
    activity_id: String(entry.activity_id),
    athlete_name: `${entry.athlete_firstname} ${entry.athlete_lastname}`.trim(),
    elapsed_time_seconds: entry.elapsed_time,
  }));
}

/**
 * Fetches high-resolution stream arrays from Strava's public activity stream endpoint[cite: 2].
 */
export async function fetchActivityStreams(activityId: string): Promise<ActivityStreams> {
  const streamUrl = `https://www.strava.com/activities/${activityId}/streams?stream_types[]=latlng&stream_types[]=time&stream_types[]=altitude`;[cite: 2]

  const response = await fetch(streamUrl, {
    headers: {
      'User-Agent': 'FastestFlattiesScraper/1.0',
      'Accept': 'application/json',
    },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch streams for activity ${activityId}: ${response.statusText}`);
  }

  const data = (await response.json()) as any;

  if (!data.latlng || !Array.isArray(data.latlng)) {
    throw new Error(`Activity ${activityId} stream is missing latlng coordinate data.`);
  }

  return {
    latlng: data.latlng,
    time: data.time || [],
    altitude: data.altitude || [],
  };
}
</file>

