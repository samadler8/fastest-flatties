NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_secret_not_for_browser

# Must include cookie name and equal sign: _strava4_session=...
STRAVA_COOKIE=_strava4_session=your_session_cookie

# Optional, only if you use segment leaderboards
STRAVA_ACCESS_TOKEN=

COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=http://localhost:3000/api/auth/coros/callback
